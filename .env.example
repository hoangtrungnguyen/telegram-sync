# Get these from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: log in as a bot instead of a user (from @BotFather).
# The bot must be an admin of every channel you sync, and cannot resolve
# @usernames or list chats — use numeric ids. Leave empty for user login.
TELEGRAM_BOT_TOKEN=

# Comma-separated channels: @username, https://t.me/name, or numeric id.
# Optional — `telesync channels add @name` stores them instead.
TELEGRAM_CHANNELS=

# Where the markdown goes
TELESYNC_OUT_DIR=./vault

# Session file (holds your login — keep it private)
TELEGRAM_SESSION=./telesync.session

# per-message (default) or per-day
TELESYNC_LAYOUT=per-message

# Naming templates. Placeholders: date time datetime year month day hour minute
# id slug title channel channel_title channel_id username author media_type,
# plus {dt} for strftime specs e.g. {dt:%Y/%m}. Only the folder may nest with /.
TELESYNC_FOLDER_FORMAT={channel}
TELESYNC_FILENAME_FORMAT={date}-{time}-{id}-{slug}
TELESYNC_DAYFILE_FORMAT={date}

# React to every synced message so you can see what was archived
TELESYNC_REACT=true
TELESYNC_REACT_EMOJI=🦄
# Reaction when an edited message is re-synced
TELESYNC_REACT_EDIT_EMOJI=👾

# Download photos/videos/documents alongside the notes
TELESYNC_MEDIA=false
TELESYNC_MEDIA_DIR=assets

# Re-render the last N messages on every sync so edits are picked up
TELESYNC_RECHECK=0
